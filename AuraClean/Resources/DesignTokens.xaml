<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:helpers="clr-namespace:AuraClean.Helpers">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--                                                             -->
    <!--   AURACLEAN DESIGN TOKENS — OpenEval visual system          -->
    <!--   Charcoal dark / white light, violet accent, semantic      -->
    <!--   green / amber / red, color-mix surfaces.                  -->
    <!--                                                             -->
    <!--   Colors below are the DARK theme as authored in XAML.      -->
    <!--   Helpers/ThemePalette.cs is the source of truth for both   -->
    <!--   themes; Services/ThemeService.cs applies it at startup    -->
    <!--   and on every Auto / Light / Dark change, updating these   -->
    <!--   brushes in place. Never add a raw color to a view: use a  -->
    <!--   key from this file.                                       -->
    <!--                                                             -->
    <!--   STRUCTURE                                                 -->
    <!--   1. Color Primitives  — raw color values                   -->
    <!--   2. Semantic Brushes  — purpose-named SolidColorBrushes    -->
    <!--   3. Gradient Brushes  — brand & functional gradients       -->
    <!--   4. Font Families     — system sans + monospace            -->
    <!--   5. Typography Scale  — named font sizes                   -->
    <!--   6. Spacing Scale     — margin/padding values              -->
    <!--   7. Radius Scale      — corner radius values               -->
    <!--   8. Layout Constants  — fixed dimensions                   -->
    <!--   9. Motion            — durations and easing curves        -->
    <!--                                                             -->
    <!-- ═══════════════════════════════════════════════════════════ -->


    <!-- ─────────────────────────────────────────────── -->
    <!--  1. COLOR PRIMITIVES                            -->
    <!--  Raw named colors. Consume via brushes below;   -->
    <!--  Color keys are only for effects/gradients.     -->
    <!-- ─────────────────────────────────────────────── -->

    <Color x:Key="AuraBgColor">#0A0A0B</Color>
    <Color x:Key="AuraSurfaceColor">#111113</Color>
    <Color x:Key="AuraSurfaceLightColor">#16161A</Color>
    <Color x:Key="AuraSurfaceElevatedColor">#1D1D22</Color>
    <Color x:Key="AuraVioletColor">#7C5CFF</Color>
    <Color x:Key="AuraVioletDarkColor">#7C5CFF</Color>
    <Color x:Key="AuraVioletLightColor">#A78BFF</Color>
    <Color x:Key="AuraAccentColor">#7C5CFF</Color>
    <Color x:Key="AuraAccentSoftColor">#A78BFF</Color>
    <Color x:Key="AuraCyanColor">#64C8C0</Color>
    <Color x:Key="AuraBlueColor">#64C8C0</Color>
    <Color x:Key="AuraMintColor">#3FB950</Color>
    <Color x:Key="AuraAmberColor">#D29922</Color>
    <Color x:Key="AuraCoralColor">#F85149</Color>
    <Color x:Key="AuraCriticalColor">#F85149</Color>
    <Color x:Key="AuraTextBrightColor">#E8E8EA</Color>
    <Color x:Key="AuraTextColor">#E8E8EA</Color>
    <Color x:Key="AuraTextDimColor">#8B8B94</Color>
    <Color x:Key="AuraTextMutedColor">#82828C</Color>
    <Color x:Key="AuraBorderColor">#26262B</Color>
    <Color x:Key="AuraBorderSubtleColor">#1D1D22</Color>
    <Color x:Key="AuraShadowColor">#2E000000</Color>


    <!-- ─────────────────────────────────────────────── -->
    <!--  2. SEMANTIC BRUSHES                            -->
    <!--  Purpose-named. Use these in views.             -->
    <!-- ─────────────────────────────────────────────── -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AuraBackground" Color="#0A0A0B" />
    <SolidColorBrush x:Key="AuraBgSubtle" Color="#111113" />
    <SolidColorBrush x:Key="AuraBgElev" Color="#16161A" />
    <SolidColorBrush x:Key="AuraSurface" Color="#111113" />
    <SolidColorBrush x:Key="AuraSurfaceLight" Color="#16161A" />
    <SolidColorBrush x:Key="AuraSurfaceElevated" Color="#1D1D22" />
    <SolidColorBrush x:Key="AuraCardBackground" Color="#111113" />
    <SolidColorBrush x:Key="AuraCardBorder" Color="#313137" />
    <SolidColorBrush x:Key="AuraCardHoverBorder" Color="#4A3D84" />
    <SolidColorBrush x:Key="AuraShellBackground" Color="#101012" />
    <SolidColorBrush x:Key="AuraInputBackground" Color="#0A0A0B" />
    <SolidColorBrush x:Key="AuraTableHeader" Color="#111113" />
    <SolidColorBrush x:Key="AuraStatBackground" Color="#8A0A0A0B" />
    <SolidColorBrush x:Key="AuraStatBorder" Color="#B826262B" />
    <SolidColorBrush x:Key="AuraPageIconBackground" Color="#1C182B" />
    <SolidColorBrush x:Key="AuraPageIconBorder" Color="#342C57" />

    <!-- Interaction states (hover, active, focus, selection, rows) -->
    <SolidColorBrush x:Key="AuraHoverBackground" Color="#151519" />
    <SolidColorBrush x:Key="AuraHoverBorder" Color="#38383E" />
    <SolidColorBrush x:Key="AuraActiveBackground" Color="#201C34" />
    <SolidColorBrush x:Key="AuraActiveBorder" Color="#3B335E" />
    <SolidColorBrush x:Key="AuraFocusRing" Color="#1F7C5CFF" />
    <SolidColorBrush x:Key="AuraSelection" Color="#2A214F" />
    <SolidColorBrush x:Key="AuraRowHover" Color="#141418" />
    <SolidColorBrush x:Key="AuraRowDivider" Color="#AD26262B" />
    <SolidColorBrush x:Key="AuraLinkBorder" Color="#483C80" />
    <SolidColorBrush x:Key="AuraSelectedBackground" Color="#110F1A" />

    <!-- Segmented control (tabs / theme picker) -->
    <SolidColorBrush x:Key="AuraSegmentBorder" Color="#333339" />
    <SolidColorBrush x:Key="AuraSegmentHoverBorder" Color="#37373C" />
    <SolidColorBrush x:Key="AuraSegmentHoverBackground" Color="#151518" />
    <SolidColorBrush x:Key="AuraSegmentActiveBorder" Color="#4F4091" />
    <SolidColorBrush x:Key="AuraSegmentActiveBackground" Color="#1D192D" />

    <!-- Caveat banners: tone 42% border over bd-subtle, tone 8% fill over bg-subtle -->
    <SolidColorBrush x:Key="AuraWarnBannerBackground" Color="#201C14" />
    <SolidColorBrush x:Key="AuraWarnBannerBorder" Color="#695122" />
    <SolidColorBrush x:Key="AuraErrBannerBackground" Color="#231617" />
    <SolidColorBrush x:Key="AuraErrBannerBorder" Color="#793332" />
    <SolidColorBrush x:Key="AuraPrimaryHoverOverlay" Color="#1A0A0A0B" />
    <SolidColorBrush x:Key="AuraScrollThumb" Color="#26262B" />
    <SolidColorBrush x:Key="AuraScrollThumbHover" Color="#82828C" />

    <!-- Text: fg / fg-muted / fg-dim -->
    <SolidColorBrush x:Key="AuraTextBright" Color="#E8E8EA" />
    <SolidColorBrush x:Key="AuraTextPrimary" Color="#E8E8EA" />
    <SolidColorBrush x:Key="AuraTextSecondary" Color="#8B8B94" />
    <SolidColorBrush x:Key="AuraTextMuted" Color="#82828C" />

    <!-- Borders -->
    <SolidColorBrush x:Key="AuraBorder" Color="#26262B" />
    <SolidColorBrush x:Key="AuraBorderSubtle" Color="#1D1D22" />

    <!-- Accent: fills use AuraAccent, text and icons use AuraAccentSoft -->
    <SolidColorBrush x:Key="AuraAccent" Color="#7C5CFF" />
    <SolidColorBrush x:Key="AuraAccentSoft" Color="#A78BFF" />
    <SolidColorBrush x:Key="AuraAccentPurple" Color="#A78BFF" />
    <SolidColorBrush x:Key="AuraAccentLight" Color="#A78BFF" />

    <!-- Semantic tones (never color-only: pair with text or an icon) -->
    <SolidColorBrush x:Key="AuraOk" Color="#3FB950" />
    <SolidColorBrush x:Key="AuraWarn" Color="#D29922" />
    <SolidColorBrush x:Key="AuraErr" Color="#F85149" />
    <SolidColorBrush x:Key="AuraInfo" Color="#64C8C0" />
    <SolidColorBrush x:Key="AuraAccentTeal" Color="#64C8C0" />
    <SolidColorBrush x:Key="AuraSuccess" Color="#3FB950" />
    <SolidColorBrush x:Key="AuraAmber" Color="#D29922" />
    <SolidColorBrush x:Key="AuraWarning" Color="#F85149" />
    <SolidColorBrush x:Key="AuraCritical" Color="#F85149" />

    <!-- Status pill tints (fill: tone 10% over bg-subtle) and lines (border: tone 38% over bd) -->
    <SolidColorBrush x:Key="AuraAccentTint" Color="#1C182B" />
    <SolidColorBrush x:Key="AuraAccentLine" Color="#473B7C" />
    <SolidColorBrush x:Key="AuraOkTint" Color="#162219" />
    <SolidColorBrush x:Key="AuraOkLine" Color="#305E39" />
    <SolidColorBrush x:Key="AuraWarnTint" Color="#241F14" />
    <SolidColorBrush x:Key="AuraWarnLine" Color="#675228" />
    <SolidColorBrush x:Key="AuraErrTint" Color="#281718" />
    <SolidColorBrush x:Key="AuraErrLine" Color="#763636" />
    <SolidColorBrush x:Key="AuraInfoTint" Color="#192324" />
    <SolidColorBrush x:Key="AuraInfoLine" Color="#3E6464" />

    <!-- Legacy keys consumed by existing views (mapped onto the tokens above) -->
    <SolidColorBrush x:Key="AuraAccentPurpleSemi" Color="#1C182B" />
    <SolidColorBrush x:Key="AuraAccentTealSemi" Color="#192324" />
    <SolidColorBrush x:Key="AuraAmberSemi" Color="#241F14" />
    <SolidColorBrush x:Key="AuraCoralSemi" Color="#281718" />
    <SolidColorBrush x:Key="AuraIconBadgeBg" Color="#1C182B" />
    <SolidColorBrush x:Key="AuraNeutralBadge" Color="#16161A" />
    <SolidColorBrush x:Key="AuraOverlayLight" Color="#151519" />
    <SolidColorBrush x:Key="AuraOverlaySubtle" Color="#A816161A" />
    <SolidColorBrush x:Key="AuraOverlayFaint" Color="#9416161A" />
    <SolidColorBrush x:Key="AuraTrackBg" Color="#16161A" />
    <SolidColorBrush x:Key="AuraSuccessBadge" Color="#162219" />
    <SolidColorBrush x:Key="AuraSuccessTint" Color="#162219" />
    <SolidColorBrush x:Key="AuraWarningBadge" Color="#241F14" />
    <SolidColorBrush x:Key="AuraCriticalBadge" Color="#281718" />
    <SolidColorBrush x:Key="AuraInfoBadge" Color="#192324" />
    <SolidColorBrush x:Key="AuraAccentPurpleBadge" Color="#1C182B" />
    <SolidColorBrush x:Key="AuraAccentTealBadge" Color="#192324" />
    <SolidColorBrush x:Key="AuraAmberBadge" Color="#241F14" />
    <SolidColorBrush x:Key="AuraBlueBadge" Color="#192324" />
    <SolidColorBrush x:Key="AuraCriticalSeverity" Color="#311A1B" />
    <SolidColorBrush x:Key="AuraCoralSeverity" Color="#311A1B" />
    <SolidColorBrush x:Key="AuraAmberSeverity" Color="#2C2415" />
    <SolidColorBrush x:Key="AuraSuccessSeverity" Color="#17291C" />


    <!-- ─────────────────────────────────────────────── -->
    <!--  3. GRADIENT BRUSHES                            -->
    <!--  Brand mark: accent → accent-soft (bottom-right).-->
    <!--  Shell and score card are flat by design; the   -->
    <!--  glow brushes are transparent (no ambient glow). -->
    <!-- ─────────────────────────────────────────────── -->

    <LinearGradientBrush x:Key="AuraGradientAccent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C5CFF" Offset="0" />
        <GradientStop Color="#A78BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AuraGradientVertical" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7C5CFF" Offset="0" />
        <GradientStop Color="#A78BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AuraGradientHorizontal" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#7C5CFF" Offset="0" />
        <GradientStop Color="#A78BFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AuraGradientWarm" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#F85149" Offset="0" />
        <GradientStop Color="#D29922" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AuraSidebarGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#101012" Offset="0" />
        <GradientStop Color="#101012" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AuraGradientScoreCard" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#111113" Offset="0" />
        <GradientStop Color="#111113" Offset="0.5" />
        <GradientStop Color="#111113" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AuraGradientLogo" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#E8E8EA" Offset="0" />
        <GradientStop Color="#A78BFF" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="AuraGlowViolet" Center="0.5,0.4" RadiusX="0.6" RadiusY="0.8">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="0.5" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AuraGlowHero" Center="0.5,0.3" RadiusX="0.6" RadiusY="0.8">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="0.5" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <!-- ─────────────────────────────────────────────── -->
    <!--  4. FONT FAMILIES                               -->
    <!--  System UI sans (Segoe UI on Windows) for text; -->
    <!--  monospace for every number, size, ID and time. -->
    <!--  Pair mono with AuraMono / AuraStatValue styles -->
    <!--  for tabular figures and slashed zero.          -->
    <!-- ─────────────────────────────────────────────── -->

    <FontFamily x:Key="AuraFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="AuraFontFamilyMono">Cascadia Mono, Consolas</FontFamily>


    <!-- ─────────────────────────────────────────────── -->
    <!--  5. TYPOGRAPHY SCALE                            -->
    <!--  Eyebrows 10, meta 11, body 12–14, KPI 18,      -->
    <!--  page titles 24. Nothing larger except the      -->
    <!--  dashboard health score.                        -->
    <!-- ─────────────────────────────────────────────── -->

    <!-- Eyebrow / section label (uppercase, dim) and badges -->
    <sys:Double x:Key="AuraFontSizeXS">10</sys:Double>
    <sys:Double x:Key="AuraFontSizeEyebrow">10</sys:Double>

    <!-- Meta: status text, helper text, timestamps, pills -->
    <sys:Double x:Key="AuraFontSizeCaption">11</sys:Double>

    <!-- Small body: descriptions, labels, list secondary lines -->
    <sys:Double x:Key="AuraFontSizeLabel">12</sys:Double>

    <!-- Body: primary content text -->
    <sys:Double x:Key="AuraFontSizeBody">13</sys:Double>

    <!-- Emphasis: card titles, button text, nav items -->
    <sys:Double x:Key="AuraFontSizeMD">14</sys:Double>

    <!-- Dialog / section heading -->
    <sys:Double x:Key="AuraFontSizeLG">16</sys:Double>

    <!-- KPI value (mono, tabular) -->
    <sys:Double x:Key="AuraFontSizeKpi">18</sys:Double>
    <sys:Double x:Key="AuraFontSizeXL">18</sys:Double>

    <!-- Secondary page title -->
    <sys:Double x:Key="AuraFontSizeTitle">20</sys:Double>

    <!-- Page title -->
    <sys:Double x:Key="AuraFontSizeDisplay">24</sys:Double>

    <!-- Hero: dashboard health score only — use AuraFontFamilyMono -->
    <sys:Double x:Key="AuraFontSizeHero">64</sys:Double>


    <!-- ─────────────────────────────────────────────── -->
    <!--  6. SPACING SCALE                               -->
    <!--  Named Thickness values for margins & padding.  -->
    <!-- ─────────────────────────────────────────────── -->

    <!-- 4px — micro gap: icon-to-label, inline spacing -->
    <Thickness x:Key="AuraSpaceXS">4</Thickness>

    <!-- 8px — small gap: between related items -->
    <Thickness x:Key="AuraSpaceS">8</Thickness>

    <!-- 12px — medium gap: between grouped elements -->
    <Thickness x:Key="AuraSpaceM">12</Thickness>

    <!-- 16px — standard gap: card padding, section gaps -->
    <Thickness x:Key="AuraSpaceL">16</Thickness>

    <!-- 20px — comfortable gap: between sections -->
    <Thickness x:Key="AuraSpaceXL">20</Thickness>

    <!-- 24px — generous gap: major section separations -->
    <Thickness x:Key="AuraSpace2XL">24</Thickness>

    <!-- 32px — page margin: outer content padding -->
    <Thickness x:Key="AuraSpace3XL">32</Thickness>

    <!-- Bottom-only spacing variants (most common margin pattern) -->
    <Thickness x:Key="AuraSpaceBottomXS">0,0,0,4</Thickness>
    <Thickness x:Key="AuraSpaceBottomS">0,0,0,8</Thickness>
    <Thickness x:Key="AuraSpaceBottomM">0,0,0,12</Thickness>
    <Thickness x:Key="AuraSpaceBottomL">0,0,0,16</Thickness>
    <Thickness x:Key="AuraSpaceBottomXL">0,0,0,20</Thickness>
    <Thickness x:Key="AuraSpaceBottom2XL">0,0,0,24</Thickness>

    <!-- Top-only spacing variants -->
    <Thickness x:Key="AuraSpaceTopXS">0,4,0,0</Thickness>
    <Thickness x:Key="AuraSpaceTopS">0,8,0,0</Thickness>
    <Thickness x:Key="AuraSpaceTopM">0,12,0,0</Thickness>

    <!-- Right-only spacing variants -->
    <Thickness x:Key="AuraSpaceRightM">0,0,12,0</Thickness>
    <Thickness x:Key="AuraSpaceRightL">0,0,16,0</Thickness>

    <!-- Page margin: default outer content margin -->
    <Thickness x:Key="AuraPageMargin">32,24,32,16</Thickness>


    <!-- ─────────────────────────────────────────────── -->
    <!--  7. RADIUS SCALE                                -->
    <!--  Cards 12, page actions and dialog buttons 8,   -->
    <!--  controls and nav 6, tags 4, pills full.        -->
    <!-- ─────────────────────────────────────────────── -->

    <!-- 4px — tags, tiny badges -->
    <CornerRadius x:Key="AuraRadiusXS">4</CornerRadius>

    <!-- 6px — controls: inputs, secondary buttons, nav links, menu items -->
    <CornerRadius x:Key="AuraRadiusSM">6</CornerRadius>
    <CornerRadius x:Key="AuraRadiusControl">6</CornerRadius>

    <!-- 8px — page actions, primary buttons, dialog buttons, stat tiles -->
    <CornerRadius x:Key="AuraRadiusBase">8</CornerRadius>
    <CornerRadius x:Key="AuraRadiusAction">8</CornerRadius>

    <!-- 6px — legacy "medium" controls (buttons, icon badges, nav items) -->
    <CornerRadius x:Key="AuraRadiusM">6</CornerRadius>

    <!-- 12px — every card and panel -->
    <CornerRadius x:Key="AuraRadiusL">12</CornerRadius>
    <CornerRadius x:Key="AuraRadiusXL">12</CornerRadius>
    <CornerRadius x:Key="AuraRadius2XL">12</CornerRadius>
    <CornerRadius x:Key="AuraRadiusCard">12</CornerRadius>

    <!-- Pills, dots and chips -->
    <CornerRadius x:Key="AuraRadiusFull">999</CornerRadius>


    <!-- ─────────────────────────────────────────────── -->
    <!--  8. LAYOUT CONSTANTS                            -->
    <!-- ─────────────────────────────────────────────── -->

    <!-- Sidebar width -->
    <sys:Double x:Key="AuraSidebarWidth">260</sys:Double>

    <!-- Page-header icon tile (32px) and its icon (16px) -->
    <sys:Double x:Key="AuraIconBadgeSize">32</sys:Double>
    <sys:Double x:Key="AuraIconBadgeIconSize">16</sys:Double>

    <!-- Hit targets: 40px default, 44px for touch/primary -->
    <sys:Double x:Key="AuraNavButtonHeight">40</sys:Double>
    <sys:Double x:Key="AuraHitTarget">40</sys:Double>


    <!-- ─────────────────────────────────────────────── -->
    <!--  9. MOTION                                      -->
    <!--  Short and interruptible. Durations collapse to -->
    <!--  zero when Windows animations are turned off.   -->
    <!-- ─────────────────────────────────────────────── -->

    <Duration x:Key="AuraMotionFast">0:0:0.12</Duration>
    <Duration x:Key="AuraMotionControl">0:0:0.15</Duration>
    <Duration x:Key="AuraMotionPanel">0:0:0.18</Duration>

    <!-- cubic-bezier(.2, 0, 0, 1): buttons, menus, nav -->
    <helpers:CubicBezierEase x:Key="AuraEaseControl" X1="0.2" Y1="0" X2="0" Y2="1" />
    <!-- cubic-bezier(.16, 1, .3, 1): toasts, reveals -->
    <helpers:CubicBezierEase x:Key="AuraEaseEntrance" X1="0.16" Y1="1" X2="0.3" Y2="1" />

</ResourceDictionary>
