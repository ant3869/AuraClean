<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:helpers="clr-namespace:AuraClean.Helpers">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!--                                                             -->
    <!--   AURACLEAN COMPONENT STYLES — OpenEval recipes             -->
    <!--                                                             -->
    <!--   Every color comes from DesignTokens.xaml through          -->
    <!--   DynamicResource so Auto / Light / Dark switch live.       -->
    <!--   Hover and active states fade dedicated layers (150ms,     -->
    <!--   cubic-bezier(.2,0,0,1)); press scales to .96.             -->
    <!--                                                             -->
    <!--   SECTIONS                                                  -->
    <!--   1. Focus     — 2px accent outline                         -->
    <!--   2. Navigation — sidebar link with accent rail             -->
    <!--   3. Buttons   — primary, secondary, link, danger, icon     -->
    <!--   4. Toggles   — checkbox hit target                        -->
    <!--   5. Cards     — card, stat tile, data, hero, banners       -->
    <!--   6. Inputs    — search box                                 -->
    <!--   7. Text      — page title, eyebrow, KPI, mono             -->
    <!--   8. Badges    — status pills, chips, tags                  -->
    <!--   9. Chrome    — scrollbars, tooltips                       -->
    <!--                                                             -->
    <!-- ═══════════════════════════════════════════════════════════ -->


    <!-- ═══════════════════════════════════════════ -->
    <!--  1. FOCUS                                   -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- 2px accent outline with 1px offset, shared by every interactive control -->
    <Style x:Key="AuraFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource AuraAccent}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Margin="-3"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════════════════ -->
    <!--  2. NAVIGATION                              -->
    <!--  Muted link; hover = bg-elev blend + border; -->
    <!--  active = accent-tinted fill + accent border -->
    <!--  + accent-soft text + 2px glowing rail.      -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="AuraNavButton" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AuraFocusVisual}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AuraTextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource AuraFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeMD}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="{StaticResource AuraNavButtonHeight}" />
        <Setter Property="Margin" Value="0,1" />
        <!-- One selection group across every sidebar section (WPF otherwise groups radio
             buttons per parent panel, leaving an item highlighted in each section). -->
        <Setter Property="GroupName" Value="AuraMainNavigation" />
        <!-- Content fills the row so trailing elements (shortcut hints) sit at the right edge. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="8,0" Background="Transparent">
                        <Border x:Name="HoverLayer"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                BorderThickness="1"
                                Background="{DynamicResource AuraHoverBackground}"
                                BorderBrush="{DynamicResource AuraHoverBorder}"
                                Opacity="0" />
                        <Border x:Name="ActiveLayer"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                BorderThickness="1"
                                Background="{DynamicResource AuraActiveBackground}"
                                BorderBrush="{DynamicResource AuraActiveBorder}"
                                Opacity="0" />
                        <Border x:Name="Rail"
                                Width="2"
                                HorizontalAlignment="Left"
                                Margin="0,6"
                                CornerRadius="1"
                                Background="{DynamicResource AuraAccentSoft}"
                                Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.48"
                                                  Color="{DynamicResource AuraAccentSoftColor}" />
                            </Border.Effect>
                        </Border>
                        <ContentPresenter Margin="12,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource AuraMotionControl}"
                                                         EasingFunction="{StaticResource AuraEaseControl}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource AuraMotionControl}"
                                                         EasingFunction="{StaticResource AuraEaseControl}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource AuraTextBright}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveLayer" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource AuraMotionPanel}"
                                                         EasingFunction="{StaticResource AuraEaseControl}" />
                                        <DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource AuraMotionPanel}"
                                                         EasingFunction="{StaticResource AuraEaseControl}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActiveLayer" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource AuraMotionControl}"
                                                         EasingFunction="{StaticResource AuraEaseControl}" />
                                        <DoubleAnimation Storyboard.TargetName="Rail" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource AuraMotionControl}"
                                                         EasingFunction="{StaticResource AuraEaseControl}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource AuraAccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Segmented control: container + RadioButton items (tabs, theme picker) -->
    <Style x:Key="AuraSegmented" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraSegmentBorder}" />
        <Setter Property="Background" Value="{DynamicResource AuraShellBackground}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="AuraSegmentedItem" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AuraFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource AuraTextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource AuraFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="HoverLayer"
                                CornerRadius="7" BorderThickness="1"
                                Background="{DynamicResource AuraSegmentHoverBackground}"
                                BorderBrush="{DynamicResource AuraSegmentHoverBorder}"
                                Opacity="0" />
                        <Border x:Name="ActiveLayer"
                                CornerRadius="7" BorderThickness="1"
                                Background="{DynamicResource AuraSegmentActiveBackground}"
                                BorderBrush="{DynamicResource AuraSegmentActiveBorder}"
                                Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource AuraMotionControl}"
                                                         EasingFunction="{StaticResource AuraEaseControl}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource AuraMotionControl}"
                                                         EasingFunction="{StaticResource AuraEaseControl}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource AuraTextBright}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ActiveLayer" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource AuraTextBright}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════════════════ -->
    <!--  3. BUTTONS                                 -->
    <!--  One template; variants set fill, border,   -->
    <!--  radius and the hover layer via             -->
    <!--  helpers:ControlAssist.                     -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="AuraButtonBase" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AuraFocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource AuraFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="helpers:ControlAssist.CornerRadius" Value="{StaticResource AuraRadiusControl}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Path=(helpers:ControlAssist.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="HoverLayer"
                                Opacity="0"
                                Background="{Binding Path=(helpers:ControlAssist.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"
                                BorderBrush="{Binding Path=(helpers:ControlAssist.HoverBorderBrush), RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Path=(helpers:ControlAssist.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource AuraMotionControl}"
                                                         EasingFunction="{StaticResource AuraEaseControl}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource AuraMotionControl}"
                                                         EasingFunction="{StaticResource AuraEaseControl}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0.96" Duration="{StaticResource AuraMotionFast}"
                                                         EasingFunction="{StaticResource AuraEaseControl}" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0.96" Duration="{StaticResource AuraMotionFast}"
                                                         EasingFunction="{StaticResource AuraEaseControl}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="{StaticResource AuraMotionControl}"
                                                         EasingFunction="{StaticResource AuraEaseControl}" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="{StaticResource AuraMotionControl}"
                                                         EasingFunction="{StaticResource AuraEaseControl}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary: flat accent fill, white text, 8px radius, 40px hit target -->
    <Style x:Key="AuraPrimaryButton" TargetType="Button" BasedOn="{StaticResource AuraButtonBase}">
        <Setter Property="Background" Value="{DynamicResource AuraAccent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeMD}" />
        <Setter Property="MinHeight" Value="{StaticResource AuraHitTarget}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="helpers:ControlAssist.CornerRadius" Value="{StaticResource AuraRadiusAction}" />
        <Setter Property="helpers:ControlAssist.HoverBackground" Value="{DynamicResource AuraPrimaryHoverOverlay}" />
    </Style>

    <!-- Secondary: filled surface, visible border and full-contrast text so it reads as a button -->
    <Style x:Key="AuraSecondaryButton" TargetType="Button" BasedOn="{StaticResource AuraButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBright}" />
        <Setter Property="Background" Value="{DynamicResource AuraButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraButtonBorder}" />
        <Setter Property="helpers:ControlAssist.HoverBackground" Value="{DynamicResource AuraButtonHoverBackground}" />
        <Setter Property="helpers:ControlAssist.HoverBorderBrush" Value="{DynamicResource AuraButtonHoverBorder}" />
    </Style>

    <!-- Ghost: the everyday secondary action (same recipe as Secondary) -->
    <Style x:Key="AuraGhostButton" TargetType="Button" BasedOn="{StaticResource AuraSecondaryButton}" />

    <!-- Link-ish action: accent-soft text on an accent-tinted surface -->
    <Style x:Key="AuraOutlinedButton" TargetType="Button" BasedOn="{StaticResource AuraButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource AuraAccentSoft}" />
        <Setter Property="Background" Value="{DynamicResource AuraAccentTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraAccentLine}" />
        <Setter Property="helpers:ControlAssist.HoverBackground" Value="{DynamicResource AuraAccentStrong}" />
        <Setter Property="helpers:ControlAssist.HoverBorderBrush" Value="{DynamicResource AuraAccentLine}" />
    </Style>

    <!-- Tone buttons: tone text, tone 10% fill, tone 38% border; stronger fill on hover.
         Use to tell neighboring actions apart by meaning (accent / ok / warn / info / danger). -->
    <Style x:Key="AuraAccentToneButton" TargetType="Button" BasedOn="{StaticResource AuraOutlinedButton}" />

    <Style x:Key="AuraOkButton" TargetType="Button" BasedOn="{StaticResource AuraButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource AuraOk}" />
        <Setter Property="Background" Value="{DynamicResource AuraOkTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOkLine}" />
        <Setter Property="helpers:ControlAssist.HoverBackground" Value="{DynamicResource AuraOkStrong}" />
        <Setter Property="helpers:ControlAssist.HoverBorderBrush" Value="{DynamicResource AuraOkLine}" />
    </Style>

    <Style x:Key="AuraWarnButton" TargetType="Button" BasedOn="{StaticResource AuraButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource AuraWarn}" />
        <Setter Property="Background" Value="{DynamicResource AuraWarnTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraWarnLine}" />
        <Setter Property="helpers:ControlAssist.HoverBackground" Value="{DynamicResource AuraWarnStrong}" />
        <Setter Property="helpers:ControlAssist.HoverBorderBrush" Value="{DynamicResource AuraWarnLine}" />
    </Style>

    <Style x:Key="AuraInfoButton" TargetType="Button" BasedOn="{StaticResource AuraButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource AuraInfo}" />
        <Setter Property="Background" Value="{DynamicResource AuraInfoTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInfoLine}" />
        <Setter Property="helpers:ControlAssist.HoverBackground" Value="{DynamicResource AuraInfoStrong}" />
        <Setter Property="helpers:ControlAssist.HoverBorderBrush" Value="{DynamicResource AuraInfoLine}" />
    </Style>

    <!-- Danger: err tone for permanent, destructive actions -->
    <Style x:Key="AuraDangerButton" TargetType="Button" BasedOn="{StaticResource AuraButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource AuraErr}" />
        <Setter Property="Background" Value="{DynamicResource AuraErrTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraErrLine}" />
        <Setter Property="helpers:ControlAssist.HoverBackground" Value="{DynamicResource AuraErrStrong}" />
        <Setter Property="helpers:ControlAssist.HoverBorderBrush" Value="{DynamicResource AuraErrLine}" />
    </Style>

    <!-- Icon-only: dim glyph, bg-elev on hover. Always set AutomationProperties.Name and ToolTip. -->
    <Style x:Key="AuraIconButton" TargetType="Button" BasedOn="{StaticResource AuraButtonBase}">
        <Setter Property="Foreground" Value="{DynamicResource AuraTextMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="{StaticResource AuraHitTarget}" />
        <Setter Property="MinHeight" Value="{StaticResource AuraHitTarget}" />
        <Setter Property="helpers:ControlAssist.HoverBackground" Value="{DynamicResource AuraBgElev}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AuraTextBright}" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ═══════════════════════════════════════════ -->
    <!--  4. TOGGLES                                 -->
    <!-- ═══════════════════════════════════════════ -->

    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>


    <!-- ═══════════════════════════════════════════ -->
    <!--  5. CARDS                                   -->
    <!--    AuraCard        — general container      -->
    <!--    AuraStatCard    — KPI tile               -->
    <!--    AuraActionCard  — selected / starter     -->
    <!--    AuraDataCard    — lists / tables (flush) -->
    <!--    AuraSectionCard — stacked sections       -->
    <!--    AuraHeroCard    — focal section          -->
    <!--    AuraInteractiveCard — clickable card     -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Card: blended bg-subtle surface, 12px radius -->
    <Style x:Key="AuraCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AuraCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusCard}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Legacy alias — all Glass references keep working -->
    <Style x:Key="AuraGlassCard" TargetType="Border" BasedOn="{StaticResource AuraCard}" />

    <!-- Stat tile: translucent over the page, 8px radius, compact -->
    <Style x:Key="AuraStatCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AuraStatBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraStatBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusAction}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Legacy alias -->
    <Style x:Key="AuraGlassCardCompact" TargetType="Border" BasedOn="{StaticResource AuraStatCard}" />

    <!-- Selected / starter card: accent-tinted border and fill -->
    <Style x:Key="AuraActionCard" TargetType="Border" BasedOn="{StaticResource AuraCard}">
        <Setter Property="Background" Value="{DynamicResource AuraSelectedBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraActiveBorder}" />
    </Style>

    <!-- Data card: lists, tables, data grids (flush, no padding) -->
    <Style x:Key="AuraDataCard" TargetType="Border" BasedOn="{StaticResource AuraCard}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Legacy alias -->
    <Style x:Key="AuraGlassCardFlush" TargetType="Border" BasedOn="{StaticResource AuraDataCard}" />

    <!-- Section card: standard card with bottom margin for vertical stacking -->
    <Style x:Key="AuraSectionCard" TargetType="Border" BasedOn="{StaticResource AuraCard}">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- Hero card: focal section, roomier padding -->
    <Style x:Key="AuraHeroCard" TargetType="Border" BasedOn="{StaticResource AuraCard}">
        <Setter Property="Padding" Value="24" />
    </Style>

    <!-- Interactive card: accent border on hover -->
    <Style x:Key="AuraInteractiveCard" TargetType="Border" BasedOn="{StaticResource AuraCard}">
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AuraCardHoverBorder}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Group expander: a shaded, accent-edged header band (chevron + title) above the rows it
         owns, so a group's heading never blends into its content. Put it inside a flush card. -->
    <Style x:Key="AuraGroupExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource AuraTextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource AuraFontFamily}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton x:Name="HeaderSite"
                                      DockPanel.Dock="Top"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      FocusVisualStyle="{StaticResource AuraFocusVisual}"
                                      Cursor="Hand"
                                      Foreground="{DynamicResource AuraTextBright}"
                                      AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                                      AutomationProperties.HelpText="Show or hide this group">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Band"
                                            Background="{DynamicResource AuraGroupHeaderBackground}"
                                            BorderBrush="{DynamicResource AuraBorderSubtle}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="7,7,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Accent edge marks the band as a heading -->
                                            <Border Width="3" CornerRadius="1.5" Margin="0,8"
                                                    Background="{DynamicResource AuraAccentSoft}" />
                                            <materialDesign:PackIcon x:Name="Chevron" Grid.Column="1"
                                                                     Kind="ChevronDown" Width="18" Height="18"
                                                                     Foreground="{DynamicResource AuraAccentSoft}"
                                                                     Margin="10,0,10,0"
                                                                     VerticalAlignment="Center"
                                                                     RenderTransformOrigin="0.5,0.5">
                                            </materialDesign:PackIcon>
                                            <ContentPresenter Grid.Column="2" Margin="0,10,14,10"
                                                              VerticalAlignment="Center"
                                                              RecognizesAccessKey="True" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Band" Property="Background" Value="{DynamicResource AuraGroupHeaderHover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="-90" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="Band" Property="CornerRadius" Value="7" />
                                            <Setter TargetName="Band" Property="BorderThickness" Value="0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite"
                                          Margin="{TemplateBinding Padding}"
                                          Visibility="Collapsed"
                                          Focusable="False" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Group title inside an AuraGroupExpander header: 14 semibold, full contrast -->
    <Style x:Key="AuraGroupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeMD}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBright}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Caveat banners: amber for warnings, red for errors. Pair with an icon and a title. -->
    <Style x:Key="AuraWarningBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AuraWarnBannerBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraWarnBannerBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusCard}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="AuraErrorBanner" TargetType="Border" BasedOn="{StaticResource AuraWarningBanner}">
        <Setter Property="Background" Value="{DynamicResource AuraErrBannerBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraErrBannerBorder}" />
    </Style>

    <!-- Page-header icon tile: 32px, accent-tinted -->
    <Style x:Key="AuraPageIcon" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource AuraIconBadgeSize}" />
        <Setter Property="Height" Value="{StaticResource AuraIconBadgeSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusAction}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource AuraPageIconBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraPageIconBorder}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AuraAccentSoft}" />
    </Style>


    <!-- ═══════════════════════════════════════════ -->
    <!--  6. INPUTS                                  -->
    <!--  Page-colored field, 6px radius; focus =    -->
    <!--  accent border + 3px 12% accent ring.       -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="AuraSearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource AuraInputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBright}" />
        <Setter Property="FontFamily" Value="{StaticResource AuraFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeBody}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource AuraAccentSoft}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AuraSelection}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Ring"
                                Margin="-3"
                                CornerRadius="9"
                                BorderThickness="3"
                                BorderBrush="{DynamicResource AuraFocusRing}"
                                Opacity="0" />
                        <Border x:Name="Bd"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AuraHoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AuraAccent}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ═══════════════════════════════════════════ -->
    <!--  7. TEXT STYLES                             -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Page title: 24 semibold, full-contrast -->
    <Style x:Key="AuraPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AuraFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBright}" />
    </Style>

    <!-- Page subtitle: one-line purpose, muted, wraps within ~72 characters -->
    <Style x:Key="AuraPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AuraFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeMD}" />
        <Setter Property="Foreground" Value="{DynamicResource AuraTextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="640" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- Card / dialog title: 14 semibold -->
    <Style x:Key="AuraSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AuraFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeMD}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBright}" />
    </Style>

    <!-- Eyebrow / section label: 10px, dim. Write the text in UPPERCASE. -->
    <Style x:Key="AuraEyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AuraFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeEyebrow}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource AuraTextMuted}" />
    </Style>

    <!-- Label text: 12, muted -->
    <Style x:Key="AuraLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AuraFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeLabel}" />
        <Setter Property="Foreground" Value="{DynamicResource AuraTextSecondary}" />
    </Style>

    <!-- Body text: 13, full-contrast -->
    <Style x:Key="AuraBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AuraFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource AuraTextPrimary}" />
    </Style>

    <!-- Numbers, sizes, IDs, timestamps: mono with tabular figures and slashed zero -->
    <Style x:Key="AuraMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AuraFontFamilyMono}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Typography.SlashedZero" Value="True" />
    </Style>

    <!-- KPI value: 18 mono semibold, tabular -->
    <Style x:Key="AuraStatValue" TargetType="TextBlock" BasedOn="{StaticResource AuraMono}">
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeKpi}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBright}" />
    </Style>

    <!-- KPI label: 10, dim. Write the text in UPPERCASE. -->
    <Style x:Key="AuraKpiLabel" TargetType="TextBlock" BasedOn="{StaticResource AuraEyebrow}" />

    <!-- Muted text: 11, dim -->
    <Style x:Key="AuraMutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AuraFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource AuraTextMuted}" />
    </Style>

    <!-- Sidebar group label: 10, dim, aligned with nav link text -->
    <Style x:Key="AuraNavSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource AuraEyebrow}">
        <Setter Property="Margin" Value="20,12,0,4" />
    </Style>


    <!-- ═══════════════════════════════════════════ -->
    <!--  8. BADGES                                  -->
    <!--  Status is never color-only: a pill holds a -->
    <!--  dot or icon plus text.                     -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Status pill (accent by default): tone 38% border, tone 10% fill, tone text -->
    <Style x:Key="AuraPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusFull}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource AuraAccentTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraAccentLine}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AuraAccentSoft}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource AuraFontSizeCaption}" />
    </Style>

    <Style x:Key="AuraPillOk" TargetType="Border" BasedOn="{StaticResource AuraPill}">
        <Setter Property="Background" Value="{DynamicResource AuraOkTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraOkLine}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AuraOk}" />
    </Style>

    <Style x:Key="AuraPillWarn" TargetType="Border" BasedOn="{StaticResource AuraPill}">
        <Setter Property="Background" Value="{DynamicResource AuraWarnTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraWarnLine}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AuraWarn}" />
    </Style>

    <Style x:Key="AuraPillErr" TargetType="Border" BasedOn="{StaticResource AuraPill}">
        <Setter Property="Background" Value="{DynamicResource AuraErrTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraErrLine}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AuraErr}" />
    </Style>

    <Style x:Key="AuraPillInfo" TargetType="Border" BasedOn="{StaticResource AuraPill}">
        <Setter Property="Background" Value="{DynamicResource AuraInfoTint}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraInfoLine}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AuraInfo}" />
    </Style>

    <!-- Pending / neutral pill -->
    <Style x:Key="AuraPillNeutral" TargetType="Border" BasedOn="{StaticResource AuraPill}">
        <Setter Property="Background" Value="{DynamicResource AuraBgElev}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderSubtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AuraTextMuted}" />
    </Style>

    <!-- 7px status dot; takes the tone of the pill it sits in -->
    <Style x:Key="AuraPillDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- Legacy status badge: views set the tone background; now pill-shaped -->
    <Style x:Key="AuraStatusBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusFull}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Chip: legend / category chip -->
    <Style x:Key="AuraChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusFull}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Background" Value="{DynamicResource AuraBgElev}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorderSubtle}" />
    </Style>

    <!-- Tag: small accent label for IDs and versions (pair with AuraMono text) -->
    <Style x:Key="AuraTag" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusXS}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Background" Value="{DynamicResource AuraAccentTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AuraAccentSoft}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource AuraFontSizeXS}" />
    </Style>


    <!-- ═══════════════════════════════════════════ -->
    <!--  9. CHROME                                  -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Thin 8px scrollbars: transparent track, bd thumb, fg-dim on hover -->
    <Style x:Key="AuraScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBd" CornerRadius="4" Background="{DynamicResource AuraScrollThumb}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AuraScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AuraScrollThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AuraScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource AuraScrollBarPageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource AuraScrollBarThumb}" Margin="1,0" MinHeight="24" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource AuraScrollBarPageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource AuraScrollBarPageButton}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource AuraScrollBarThumb}" Margin="0,1" MinWidth="24" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource AuraScrollBarPageButton}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tooltips: bg-elev, 7px radius, 11px text -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource AuraBgElev}" />
        <Setter Property="Foreground" Value="{DynamicResource AuraTextBright}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AuraBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource AuraFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource AuraFontSizeCaption}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
