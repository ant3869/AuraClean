<UserControl x:Class="AuraClean.Views.FileShredderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AuraClean.Converters"
             xmlns:helpers="clr-namespace:AuraClean.Helpers"
             xmlns:controls="clr-namespace:AuraClean.Views.Controls"
             AllowDrop="True"
             Drop="OnFileDrop"
             DragOver="OnDragOver">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource AuraPageIcon}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShieldLock" Width="16" Height="16"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="File Shredder" Style="{StaticResource AuraPageTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Securely delete files by overwriting data — making recovery impossible" Style="{StaticResource AuraPageSubtitle}" />
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- File List -->
            <Border x:Name="DropZoneBorder" Grid.Column="0" Style="{StaticResource AuraGlassCardFlush}"
                    CornerRadius="12"
                    BorderThickness="1.5"
                    BorderBrush="Transparent"
                    Focusable="True"
                    KeyDown="OnDropZoneKeyDown"
                    AutomationProperties.Name="File drop zone. Drag and drop files or press Enter to add files."
                    AutomationProperties.HelpText="You can also use the Add Files or Add Folder buttons above."
                    ToolTip="Drop files here or press Enter to browse">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="20,16" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource AuraBorderSubtle}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsAllSelected}"
                                          AutomationProperties.Name="Select All Files"
                                          ToolTip="Select All" Margin="0,0,10,0"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Files to Shred" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AuraTextPrimary}"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource AuraPill}"
                                        Padding="8,2" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasCheckedItems, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontWeight="Medium">
                                        <Run FontFamily="{StaticResource AuraFontFamilyMono}" Typography.NumeralAlignment="Tabular" Text="{Binding SelectedCount, Mode=OneWay}" />
                                        <Run Text=" selected" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Add Files"
                                        Style="{StaticResource AuraGhostButton}"
                                        Command="{Binding AddFilesCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                        Margin="0,0,8,0" />
                                <Button Content="Add Folder"
                                        Style="{StaticResource AuraGhostButton}"
                                        Command="{Binding AddFolderCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                        Margin="0,0,8,0" />
                                <Button Content="Clear"
                                        Style="{StaticResource AuraGhostButton}"
                                        Command="{Binding ClearAllCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- File ListView -->
                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Files}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="8">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              AutomationProperties.Name="Select File"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />

                                    <materialDesign:PackIcon Grid.Column="1" Kind="FileDocument" Width="20" Height="20"
                                                             Foreground="{DynamicResource AuraTextSecondary}"
                                                             VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}"
                                                   Foreground="{DynamicResource AuraTextPrimary}"
                                                   FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FullPath}"
                                                   Foreground="{DynamicResource AuraTextMuted}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock FontFamily="{StaticResource AuraFontFamilyMono}" Typography.NumeralAlignment="Tabular" Grid.Column="3" Text="{Binding FormattedSize}"
                                               Foreground="{StaticResource AuraAccentTeal}"
                                               FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center" Margin="12,0" />

                                    <Button Grid.Column="4"
                                            Style="{StaticResource AuraGhostButton}"
                                            Content="{materialDesign:PackIcon Kind=Close}"
                                            Padding="4" Foreground="{StaticResource AuraWarning}"
                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove from list" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1"
                                x:Name="EmptyState"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="ShieldLockOutline" Width="48" Height="48"
                                                 Foreground="{DynamicResource AuraTextMuted}"
                                                 Opacity="0.5"
                                                 HorizontalAlignment="Center" />
                        <TextBlock Text="No files added yet"
                                   Foreground="{DynamicResource AuraTextMuted}"
                                   FontSize="14" HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="Drag &amp; drop files here, or click 'Add Files' / 'Add Folder'"
                                   Foreground="{DynamicResource AuraTextMuted}"
                                   FontSize="12" HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Drop Overlay (shown during drag-over) -->
                    <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="3"
                            Background="{DynamicResource AuraErrBannerBackground}" CornerRadius="12"
                            Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileDownloadOutline" Width="40" Height="40"
                                                     Foreground="{StaticResource AuraWarning}"
                                                     Opacity="0.8"
                                                     HorizontalAlignment="Center" />
                            <TextBlock x:Name="DropHintText" Text="Drop files to add"
                                       Foreground="{StaticResource AuraWarning}"
                                       FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Progress -->
                    <Border Grid.Row="2" Padding="16,12"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <ProgressBar Minimum="0" Maximum="{Binding ProgressTotal}"
                                         Value="{Binding ProgressCurrent}"
                                         Foreground="{StaticResource AuraWarning}"
                                         Height="4"
                                         helpers:AnimationHelper.SmoothProgress="True" />
                            <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgressText}" Text="{Binding ProgressText}"
                                       Foreground="{DynamicResource AuraTextSecondary}"
                                       FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Panel: Algorithm Choice + Shred Button + Results -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource AuraWarningBanner}" Margin="0,0,0,16"
                        Visibility="{Binding IsNormalMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="AlertOutline" Width="16" Height="16"
                                                     Foreground="{DynamicResource AuraWarn}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Shredding needs Advanced mode"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AuraWarn}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Shredding overwrites files so they can never be recovered — not even from the Recycle Bin. You can add files here now; switch to Advanced mode when you're sure."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AuraTextSecondary}" />
                        <Button Style="{StaticResource AuraWarnButton}"
                                Command="{Binding EnableAdvancedModeCommand}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Tune" Width="16" Height="16"
                                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Switch to Advanced mode" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Algorithm Selection -->
                <Border Style="{StaticResource AuraGlassCard}"
                        CornerRadius="12" Margin="0,0,0,16"
                        Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Shred Algorithm" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AuraTextPrimary}" Margin="0,0,0,12" />

                        <ListBox ItemsSource="{Binding Algorithms}"
                                 SelectedItem="{Binding SelectedAlgorithmOption}"
                                 Background="Transparent" BorderThickness="0"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" CornerRadius="8" Padding="12,10"
                                                        Background="Transparent"
                                                        BorderBrush="{DynamicResource AuraBorderSubtle}"
                                                        BorderThickness="1" Cursor="Hand">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse x:Name="Dot" Width="16" Height="16"
                                                                 Stroke="{DynamicResource AuraTextMuted}"
                                                                 StrokeThickness="2" Fill="Transparent"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="{DynamicResource AuraTextPrimary}"
                                                                       FontSize="13" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Description}"
                                                                       Foreground="{DynamicResource AuraTextSecondary}"
                                                                       FontSize="11" />
                                                        </StackPanel>
                                                        <TextBlock FontFamily="{StaticResource AuraFontFamilyMono}" Typography.NumeralAlignment="Tabular" Grid.Column="2"
                                                                   Text="{Binding Passes, StringFormat={}{0}×}"
                                                                   Foreground="{StaticResource AuraAccentPurple}"
                                                                   FontWeight="SemiBold" FontSize="14"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AuraAccentPurple}" />
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AuraAccentPurpleSemi}" />
                                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AuraAccentPurple}" />
                                                        <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource AuraAccentPurple}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AuraOverlaySubtle}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Shred Button -->
                <Button Style="{StaticResource AuraPrimaryButton}"
                        Command="{Binding ShredAllCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Stretch"
                        Padding="0,16" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldLock" Width="20" Height="20"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SmartShredLabel}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Results Card -->
                <Border Style="{StaticResource AuraGlassCard}"
                        CornerRadius="12"
                        Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Shred Results" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AuraTextPrimary}" Margin="0,0,0,12" />

                        <Grid Margin="0,4">
                            <TextBlock Text="Files Shredded" Foreground="{DynamicResource AuraTextSecondary}" />
                            <TextBlock FontFamily="{StaticResource AuraFontFamilyMono}" Typography.NumeralAlignment="Tabular" Text="{Binding LastShredded}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource AuraSuccess}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Failed" Foreground="{DynamicResource AuraTextSecondary}" />
                            <TextBlock FontFamily="{StaticResource AuraFontFamilyMono}" Typography.NumeralAlignment="Tabular" Text="{Binding LastFailed}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource AuraWarning}" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="Data Overwritten" Foreground="{DynamicResource AuraTextSecondary}" />
                            <TextBlock FontFamily="{StaticResource AuraFontFamilyMono}" Typography.NumeralAlignment="Tabular" Text="{Binding FormattedBytesOverwritten}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource AuraAccentPurple}" FontWeight="SemiBold" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Status Bar -->
        <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" Grid.Row="2" Text="{Binding StatusMessage}"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource AuraTextSecondary}"
                   FontSize="13" Margin="0,16,0,0" />

        <!-- Post-Action Result Card -->
        <controls:ResultCard x:Name="ShredderResultCard" Grid.Row="3" />
    </Grid>
</UserControl>
