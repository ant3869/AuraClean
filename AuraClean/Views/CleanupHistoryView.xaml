<UserControl x:Class="AuraClean.Views.CleanupHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AuraClean.Converters">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource AuraPageIcon}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ClipboardTextClock" Width="16" Height="16"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Cleanup History" Style="{StaticResource AuraPageTitle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Review past cleanup operations and track space recovered" Style="{StaticResource AuraPageSubtitle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource AuraOutlinedButton}"
                        Command="{Binding ExportHistoryCommand}"
                        Padding="16,8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Export" Width="16" Height="16"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Export" VerticalAlignment="Center" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AuraGhostButton}"
                        Command="{Binding CopyToClipboardCommand}"
                        Padding="16,8" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="16" Height="16"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Copy" VerticalAlignment="Center" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AuraGhostButton}"
                        Command="{Binding ClearHistoryCommand}"
                        Foreground="{StaticResource AuraDanger}"
                        BorderBrush="{StaticResource AuraDanger}"
                        Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DeleteSweep" Width="16" Height="16"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Clear" VerticalAlignment="Center" FontSize="13" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total Operations -->
            <Border Grid.Column="0" Style="{StaticResource AuraGlassCard}" Padding="16"
                    BorderThickness="3,0,0,0" BorderBrush="{StaticResource AuraAccentTeal}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="Counter" Width="18" Height="18"
                                                 Foreground="{DynamicResource AuraInfo}" />
                        <TextBlock Text="Operations" FontSize="11" Margin="6,0,0,0"
                                   Foreground="{DynamicResource AuraTextSecondary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock FontFamily="{StaticResource AuraFontFamilyMono}" Typography.NumeralAlignment="Tabular" Text="{Binding TotalOperations}" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource AuraAccentTeal}" />
                </StackPanel>
            </Border>

            <!-- Space Freed -->
            <Border Grid.Column="2" Style="{StaticResource AuraGlassCard}" Padding="16"
                    BorderThickness="3,0,0,0" BorderBrush="{StaticResource AuraAccentTeal}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="HarddiskRemove" Width="18" Height="18"
                                                 Foreground="{DynamicResource AuraInfo}" />
                        <TextBlock Text="Space Freed" FontSize="11" Margin="6,0,0,0"
                                   Foreground="{DynamicResource AuraTextSecondary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock FontFamily="{StaticResource AuraFontFamilyMono}" Typography.NumeralAlignment="Tabular" Text="{Binding TotalBytesFreedDisplay}" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource AuraAccentTeal}" />
                </StackPanel>
            </Border>

            <!-- Items Cleaned -->
            <Border Grid.Column="4" Style="{StaticResource AuraGlassCard}" Padding="16"
                    BorderThickness="3,0,0,0" BorderBrush="{StaticResource AuraAccentTeal}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="FileRemove" Width="18" Height="18"
                                                 Foreground="{DynamicResource AuraInfo}" />
                        <TextBlock Text="Items Cleaned" FontSize="11" Margin="6,0,0,0"
                                   Foreground="{DynamicResource AuraTextSecondary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock FontFamily="{StaticResource AuraFontFamilyMono}" Typography.NumeralAlignment="Tabular" Text="{Binding TotalItemsCleaned}" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource AuraSuccess}" />
                </StackPanel>
            </Border>

            <!-- Last Operation -->
            <Border Grid.Column="6" Style="{StaticResource AuraGlassCard}" Padding="16"
                    BorderThickness="3,0,0,0" BorderBrush="{StaticResource AuraAccentTeal}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18"
                                                 Foreground="{DynamicResource AuraInfo}" />
                        <TextBlock Text="Last Cleanup" FontSize="11" Margin="6,0,0,0"
                                   Foreground="{DynamicResource AuraTextSecondary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock FontFamily="{StaticResource AuraFontFamilyMono}" Typography.NumeralAlignment="Tabular" Text="{Binding LastOperationDate}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource AuraAmber}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- D3: Daily trend strip + totals row (themed resources only) -->
        <Border Grid.Row="2" Style="{StaticResource AuraGlassCard}" Padding="16,12" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="ChartBar" Width="16" Height="16"
                                             Foreground="{DynamicResource AuraInfo}"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="Activity Trend" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"
                               Foreground="{DynamicResource AuraTextBright}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TrendSummary}" FontSize="11" Margin="12,0,0,0"
                               Foreground="{DynamicResource AuraTextSecondary}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding TrendBars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="52" Margin="0,0,8,0"
                                        ToolTip="{Binding Point.Tooltip}">
                                <Border Height="56" CornerRadius="4"
                                        Background="{DynamicResource AuraOverlayFaint}"
                                        Padding="0,0,0,0">
                                    <Border Height="{Binding BarHeight}" Width="26"
                                            CornerRadius="3"
                                            Background="{DynamicResource AuraAccent}"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Point.DayLabel}" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"
                                           Foreground="{DynamicResource AuraTextSecondary}" />
                                <TextBlock FontFamily="{StaticResource AuraFontFamilyMono}" Typography.NumeralAlignment="Tabular"
                                           Text="{Binding Point.BytesLabel}" FontSize="9"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AuraTextMuted}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Filter Bar -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Category Tabs -->
            <ItemsControl Grid.Column="0" ItemsSource="{Binding FilterTypes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource AuraBareButton}" AutomationProperties.Name="{Binding}" Command="{Binding DataContext.FilterByTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Margin="0,0,4,4" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="{StaticResource AuraRadiusControl}" Padding="10,5"
                                            Background="{DynamicResource AuraButtonBackground}"
                                            BorderBrush="{DynamicResource AuraButtonBorder}"
                                            BorderThickness="1">
                                        <TextBlock x:Name="Txt" Text="{Binding}"
                                                   FontSize="11" FontWeight="Medium"
                                                   Foreground="{DynamicResource AuraTextPrimary}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AuraButtonHoverBackground}" />
                                        </Trigger>
                                        <!-- Active filter: accent selected state -->
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource ValuesEqual}">
                                                    <Binding />
                                                    <Binding Path="DataContext.FilterType" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AuraActiveBackground}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AuraActiveBorder}" />
                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource AuraAccentSoft}" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Search -->
            <TextBox Grid.Column="2"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search history..."
                     FontSize="13"
                     Foreground="{DynamicResource AuraTextPrimary}"
                     Background="{DynamicResource AuraSurfaceLight}"
                     BorderBrush="{DynamicResource AuraBorder}"
                     Padding="10,6" VerticalAlignment="Center" />
        </Grid>

        <!-- History List -->
        <Border Grid.Row="4" Style="{StaticResource AuraGlassCard}" Padding="0">
            <ListView ItemsSource="{Binding FilteredRecords}"
                      Background="Transparent"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="16,10" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd" Background="Transparent"
                                            Padding="{TemplateBinding Padding}"
                                            BorderBrush="{DynamicResource AuraRowDivider}"
                                            BorderThickness="0,0,0,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AuraOverlayFaint}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Timestamp -->
                            <TextBlock FontFamily="{StaticResource AuraFontFamilyMono}" Typography.NumeralAlignment="Tabular" Grid.Column="0" Text="{Binding TimestampDisplay}"
                                       FontSize="12" Width="140"
                                       Foreground="{DynamicResource AuraTextSecondary}"
                                       VerticalAlignment="Center" />

                            <!-- Summary -->
                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="{Binding Summary}"
                                           FontSize="13"
                                           Foreground="{DynamicResource AuraTextBright}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Details}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AuraTextSecondary}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Size Badge -->
                            <Border Grid.Column="2" Style="{StaticResource AuraPill}" Margin="8,0">
                                <TextBlock Style="{StaticResource AuraMono}"
                                           Text="{Binding BytesFreed, Converter={StaticResource FileSizeConverter}}"
                                           FontWeight="Medium" />
                            </Border>

                            <!-- Dry-run indicator -->
                            <Border Grid.Column="3"
                                    Visibility="{Binding WasDryRun, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource AuraPillWarn}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Dry run" FontWeight="Medium" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Empty state -->
        <StackPanel Grid.Row="4"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding FilteredRecords.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
            <materialDesign:PackIcon Kind="ClipboardTextClockOutline"
                                     Width="48" Height="48"
                                     HorizontalAlignment="Center"
                                     Foreground="{DynamicResource AuraTextMuted}"
                                     Opacity="0.5" />
            <TextBlock Text="No cleanup history yet"
                       FontSize="15" Margin="0,10,0,4"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AuraTextSecondary}" />
            <TextBlock Text="Operations will appear here after you perform cleanups"
                       FontSize="12" HorizontalAlignment="Center"
                       Foreground="{DynamicResource AuraTextMuted}" />
        </StackPanel>

        <!-- Status -->
        <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" Grid.Row="5"
                   Text="{Binding StatusMessage}"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource AuraTextSecondary}"
                   FontSize="12" Margin="0,8,0,0" />
    </Grid>
</UserControl>
