<UserControl x:Class="AuraClean.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AuraClean.Converters"
             xmlns:helpers="clr-namespace:AuraClean.Helpers"
             xmlns:controls="clr-namespace:AuraClean.Views.Controls">

    <!-- HealthColorConverter and BoolToVis are defined globally in App.xaml -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
    <Grid Margin="32,24,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24"
                    helpers:AnimationHelper.AnimateOnVisible="True"
                    helpers:AnimationHelper.StaggerIndex="0">
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource AuraPageIcon}" Margin="0,0,12,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ViewDashboard" Width="16" Height="16"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="System Health" Style="{StaticResource AuraPageTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Monitor and optimize your system performance" Style="{StaticResource AuraPageSubtitle}" />
        </StackPanel>

        <!-- ═══ HERO: health score, bar, primary action ═══ -->
        <Border Grid.Row="1" Margin="0,0,0,16"
                Style="{StaticResource AuraHeroCard}"
                helpers:AnimationHelper.AnimateOnVisible="True"
                helpers:AnimationHelper.StaggerIndex="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Health score — the one hero number in the app -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding SystemHealthScore}"
                           Style="{StaticResource AuraMono}"
                           FontSize="{StaticResource AuraFontSizeHero}" FontWeight="SemiBold"
                           Foreground="{DynamicResource AuraTextBright}"
                           AutomationProperties.Name="System score"
                           ToolTip="Based on junk, threats, startup load, browser caches, and last cleanup" />

                    <!-- Trend vs the previous session: up / down / flat -->
                    <materialDesign:PackIcon Width="20" Height="20"
                                             Foreground="{Binding ScoreTrendArrow, Converter={StaticResource TrendArrowColorConverter}}"
                                             ToolTip="{Binding ScoreTrendTooltip}"
                                             AutomationProperties.Name="{Binding ScoreTrendTooltip}"
                                             Visibility="{Binding HasScoreTrend, Converter={StaticResource BoolToVis}}"
                                             VerticalAlignment="Center" Margin="8,0,0,0">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="Minus" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScoreTrendArrow}" Value="↑">
                                        <Setter Property="Kind" Value="TrendingUp" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ScoreTrendArrow}" Value="↓">
                                        <Setter Property="Kind" Value="TrendingDown" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </StackPanel>

                <!-- Score context: tone label + eyebrow -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="{Binding HealthLabel}"
                               FontSize="{StaticResource AuraFontSizeKpi}" FontWeight="SemiBold"
                               Foreground="{Binding SystemHealthScore, Converter={StaticResource HealthColorConverter}}" />
                    <controls:TrackedText Text="System score"
                                          FontSize="{StaticResource AuraFontSizeEyebrow}"
                                          Foreground="{DynamicResource AuraTextMuted}"
                                          Margin="0,4,0,0" />
                </StackPanel>

                <!-- Score bar: 8px track on bg-elev -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="32,0">
                    <Border Background="{DynamicResource AuraTrackBg}" CornerRadius="3" Height="8" />
                    <ProgressBar Value="{Binding SystemHealthScore}"
                                 Minimum="0" Maximum="100"
                                 Height="8"
                                 Foreground="{Binding SystemHealthScore, Converter={StaticResource HealthColorConverter}}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 AutomationProperties.Name="System score"
                                 helpers:AnimationHelper.SmoothProgress="True" />
                </Grid>

                <Button Grid.Column="3"
                        Style="{StaticResource AuraPrimaryButton}"
                        Command="{Binding QuickAnalyzeCommand}"
                        ToolTip="Analyzes junk across temp, cache, and logs — then choose what to clean"
                        Padding="18,10"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Analyze" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ STAT CARDS ═══ -->
        <Grid Grid.Row="2" Margin="0,0,0,16"
              helpers:AnimationHelper.AnimateOnVisible="True"
              helpers:AnimationHelper.StaggerIndex="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Junk found -->
            <Border Grid.Column="0" Style="{StaticResource AuraCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource AuraPageIcon}" Margin="0,0,16,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="DeleteSweep" Width="16" Height="16"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <controls:TrackedText Text="Junk found"
                                              FontSize="{StaticResource AuraFontSizeEyebrow}"
                                              Foreground="{DynamicResource AuraTextMuted}" />
                        <TextBlock Text="{Binding JunkTileDisplay}"
                                   Style="{StaticResource AuraMono}"
                                   FontSize="24" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AuraTextBright}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="across system temp, cache &amp; logs"
                                   FontSize="{StaticResource AuraFontSizeLabel}"
                                   Foreground="{DynamicResource AuraTextSecondary}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Programs installed -->
            <Border Grid.Column="2" Style="{StaticResource AuraCard}">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="Apps" Width="16" Height="16"
                                                 Foreground="{DynamicResource AuraTextMuted}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <controls:TrackedText Text="Programs"
                                              FontSize="{StaticResource AuraFontSizeEyebrow}"
                                              Foreground="{DynamicResource AuraTextMuted}"
                                              VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Uninstaller.Programs.Count}"
                               Style="{StaticResource AuraStatValue}"
                               FontSize="20"
                               Visibility="{Binding Uninstaller.HasScanned, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="Not scanned yet"
                               FontSize="{StaticResource AuraFontSizeBody}" FontWeight="SemiBold"
                               Foreground="{DynamicResource AuraTextMuted}"
                               Visibility="{Binding Uninstaller.HasScanned, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- Last cleaned -->
            <Border Grid.Column="4" Style="{StaticResource AuraCard}">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <materialDesign:PackIcon Kind="ClockOutline" Width="16" Height="16"
                                                 Foreground="{DynamicResource AuraTextMuted}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <controls:TrackedText Text="Last cleaned"
                                              FontSize="{StaticResource AuraFontSizeEyebrow}"
                                              Foreground="{DynamicResource AuraTextMuted}"
                                              VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastCleanedDisplay}"
                               Style="{StaticResource AuraMono}"
                               FontSize="{StaticResource AuraFontSizeLG}" FontWeight="SemiBold"
                               Foreground="{DynamicResource AuraTextBright}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ SYSTEM INFO STRIP + FRESHNESS TILES ═══ -->
        <Border Grid.Row="3" Style="{StaticResource AuraCard}" Padding="4,14"
                helpers:AnimationHelper.AnimateOnVisible="True"
                helpers:AnimationHelper.StaggerIndex="3">
            <UniformGrid Rows="1">
                <!-- OS -->
                <StackPanel Margin="16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="MicrosoftWindows" Width="14" Height="14"
                                                 Foreground="{DynamicResource AuraInfo}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <controls:TrackedText Text="OS" FontSize="{StaticResource AuraFontSizeEyebrow}"
                                              Foreground="{DynamicResource AuraTextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding OsName}"
                               Foreground="{DynamicResource AuraTextPrimary}"
                               FontSize="{StaticResource AuraFontSizeLabel}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding OsName}" />
                </StackPanel>

                <!-- CPU -->
                <StackPanel Margin="16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="Chip" Width="14" Height="14"
                                                 Foreground="{DynamicResource AuraInfo}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <controls:TrackedText Text="CPU" FontSize="{StaticResource AuraFontSizeEyebrow}"
                                              Foreground="{DynamicResource AuraTextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding CpuName}"
                               Foreground="{DynamicResource AuraTextPrimary}"
                               FontSize="{StaticResource AuraFontSizeLabel}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding CpuName}" />
                </StackPanel>

                <!-- RAM -->
                <StackPanel Margin="16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="Memory" Width="14" Height="14"
                                                 Foreground="{DynamicResource AuraInfo}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <controls:TrackedText Text="RAM" FontSize="{StaticResource AuraFontSizeEyebrow}"
                                              Foreground="{DynamicResource AuraTextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding TotalRam}"
                               Style="{StaticResource AuraMono}"
                               Foreground="{DynamicResource AuraTextBright}"
                               FontSize="{StaticResource AuraFontSizeBody}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Uptime -->
                <StackPanel Margin="16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="TimerOutline" Width="14" Height="14"
                                                 Foreground="{DynamicResource AuraInfo}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <controls:TrackedText Text="Uptime" FontSize="{StaticResource AuraFontSizeEyebrow}"
                                              Foreground="{DynamicResource AuraTextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding SystemUptime}"
                               Style="{StaticResource AuraMono}"
                               Foreground="{DynamicResource AuraTextBright}"
                               FontSize="{StaticResource AuraFontSizeBody}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Disk free (D1 freshness tile: DriveInfo on the system drive, no new service) -->
                <StackPanel Margin="16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="Harddisk" Width="14" Height="14"
                                                 Foreground="{DynamicResource AuraInfo}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <controls:TrackedText Text="Disk free" FontSize="{StaticResource AuraFontSizeEyebrow}"
                                              Foreground="{DynamicResource AuraTextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding DiskFreeDisplay}"
                               Style="{StaticResource AuraMono}"
                               Foreground="{DynamicResource AuraTextBright}"
                               FontSize="{StaticResource AuraFontSizeBody}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DiskFreeDetail}" />
                    <TextBlock Text="{Binding DiskFreeDetail}"
                               Foreground="{DynamicResource AuraTextMuted}"
                               FontSize="{StaticResource AuraFontSizeLabel}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Hardware grade (D1: shown only after a System Info visit — never blocks dashboard) -->
                <StackPanel Margin="16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="Chip" Width="14" Height="14"
                                                 Foreground="{DynamicResource AuraInfo}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <controls:TrackedText Text="Hardware" FontSize="{StaticResource AuraFontSizeEyebrow}"
                                              Foreground="{DynamicResource AuraTextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding HardwareGradeDisplay}"
                               Style="{StaticResource AuraMono}"
                               Foreground="{DynamicResource AuraTextBright}"
                               FontSize="{StaticResource AuraFontSizeBody}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding HardwareGradeDetail}" />
                    <TextBlock Text="{Binding HardwareGradeDetail}"
                               Foreground="{DynamicResource AuraTextMuted}"
                               FontSize="{StaticResource AuraFontSizeLabel}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- ═══ SECONDARY ACTIONS ═══ -->
        <WrapPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"
                   helpers:AnimationHelper.AnimateOnVisible="True"
                   helpers:AnimationHelper.StaggerIndex="4">
            <Button Style="{StaticResource AuraAccentToneButton}"
                    Command="{Binding QuickCleanCommand}"
                    ToolTip="Analyze if needed, then clean the selected low-risk items"
                    Padding="14,8" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Broom" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Quick Clean" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource AuraOkButton}"
                    Command="{Binding RunHealthCheckCommand}"
                    ToolTip="Scan junk, threats, startup load and browser caches"
                    Padding="14,8" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ShieldCheck" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Health Check" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource AuraWarnButton}"
                    Command="{Binding BoostMemoryCommand}"
                    Padding="14,8" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="RocketLaunch" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Boost RAM" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource AuraInfoButton}"
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="StorageMap"
                    Padding="14,8" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ChartDonut" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Storage Map" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource AuraGhostButton}"
                    Command="{Binding UndoLastCleanCommand}"
                    Margin="0,0,8,8"
                    Visibility="{Binding Cleaner.CanUndoLastClean, Converter={StaticResource BoolToVis}}"
                    ToolTip="Open System Restore to revert to the pre-cleanup restore point">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="UndoVariant" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Open System Restore…" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- ═══ HEALTH CHECK STATUS ═══ -->
        <StackPanel Grid.Row="5" HorizontalAlignment="Center" Margin="0,8,0,0">
            <StackPanel Visibility="{Binding IsHealthCheckRunning, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" Width="300"
                             Height="4" Margin="0,0,0,6"
                             Foreground="{DynamicResource AuraAccent}"
                             AutomationProperties.Name="Health check in progress" />
                <TextBlock Text="{Binding HealthCheckProgress}"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource AuraTextMuted}" FontSize="11"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{Binding HealthCheckSummary}"
                       AutomationProperties.LiveSetting="Polite"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"
                       Foreground="{DynamicResource AuraTextSecondary}" FontSize="12"
                       FontWeight="Medium" TextWrapping="Wrap" MaxWidth="560"
                       Visibility="{Binding IsHealthCheckRunning, Converter={StaticResource InverseBoolToVis}}" />
        </StackPanel>

        <!-- ═══ CONTEXT MENU TOGGLE ═══ -->
        <WrapPanel Grid.Row="6" HorizontalAlignment="Center" Margin="0,16,0,0" Orientation="Horizontal"
                   Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Explorer &quot;Deep Uninstall&quot; menu:"
                       Foreground="{DynamicResource AuraTextMuted}" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <!-- Status pill: green when installed, neutral otherwise -->
            <Border Margin="0,0,12,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource AuraPillNeutral}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsContextMenuInstalled}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AuraOkTint}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AuraOkLine}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource AuraOk}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ContextMenuStatus}"
                               AutomationProperties.LiveSetting="Polite"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Button Style="{StaticResource AuraGhostButton}"
                    Command="{Binding ToggleContextMenuCommand}"
                    Content="{Binding ContextMenuToggleLabel}"
                    AutomationProperties.Name="Install or remove the Explorer context menu entry"
                    Padding="10,2" FontSize="11" Margin="0,0,6,0" />
            <Button Style="{StaticResource AuraGhostButton}"
                    Command="{Binding ExportContextMenuScriptCommand}"
                    Content="Export .reg"
                    ToolTip="Save a .reg file to your Desktop that applies the same change"
                    Padding="10,2" FontSize="11" />
        </WrapPanel>
    </Grid>
    </ScrollViewer>
</UserControl>