<Window x:Class="AuraClean.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:AuraClean.ViewModels"
        xmlns:views="clr-namespace:AuraClean.Views"
        xmlns:converters="clr-namespace:AuraClean.Converters"
        xmlns:controls="clr-namespace:AuraClean.Views.Controls"
        Title="AuraClean"
        Icon="/Assets/icon.ico"
        Width="1280" Height="780"
        MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AuraBackground}"
        TextElement.Foreground="{DynamicResource AuraTextPrimary}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{StaticResource AuraFontFamily}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Keyboard hint chip (kbd): bg-elev, 4px radius, mono 10px; fades in on hover -->
        <Style x:Key="NavShortcut" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AuraBgElev}" />
            <Setter Property="CornerRadius" Value="{StaticResource AuraRadiusXS}" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TextElement.FontFamily" Value="{StaticResource AuraFontFamilyMono}" />
            <Setter Property="TextElement.FontSize" Value="10" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AuraTextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                 Duration="{StaticResource AuraMotionControl}"
                                                 EasingFunction="{StaticResource AuraEaseControl}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                                 Duration="{StaticResource AuraMotionControl}"
                                                 EasingFunction="{StaticResource AuraEaseControl}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Collapsible sidebar group header: tracked 10px label + chevron, dim → muted on hover -->
        <Style x:Key="NavGroupHeader" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource AuraFocusVisual}" />
            <Setter Property="Foreground" Value="{DynamicResource AuraTextMuted}" />
            <Setter Property="FontFamily" Value="{StaticResource AuraFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8,12,8,2" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                CornerRadius="{StaticResource AuraRadiusControl}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AuraTextSecondary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="Dashboard" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="ThreatScanner" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="Uninstaller" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="Cleaner" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="Memory" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="Browser" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="StorageMap" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="Startup" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="Shredder" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding NavigateToCommand}" CommandParameter="Settings" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="260" />
            <!-- Content -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource AuraCardBorder}" BorderThickness="0,0,1,0"
                Background="{DynamicResource AuraShellBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand: 28px gradient mark, 14px wordmark, tracked subtitle -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource AuraBorderSubtle}" BorderThickness="0,0,0,1"
                        Padding="20,18,20,16">
                    <StackPanel Orientation="Horizontal"
                                AutomationProperties.Name="AuraClean">
                        <Border Width="28" Height="28" CornerRadius="6"
                                Background="{DynamicResource AuraGradientAccent}">
                            <materialDesign:PackIcon Kind="Sparkles" Width="16" Height="16"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AuraClean"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AuraTextBright}" />
                            <controls:TrackedText Text="System Utility"
                                                  FontSize="10"
                                                  Foreground="{DynamicResource AuraTextMuted}"
                                                  Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Margin="0,10,0,10">
                        <RadioButton x:Name="NavDashboard"
                                     Style="{StaticResource AuraNavButton}" IsChecked="True"
                                     Command="{Binding NavigateToCommand}"
                                     CommandParameter="Dashboard"
                                     AutomationProperties.Name="Dashboard"
                                     AutomationProperties.AcceleratorKey="Ctrl+1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="18" Height="18" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource AuraAccentSoft}" />
                                <TextBlock Grid.Column="1" Text="Dashboard" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Style="{StaticResource NavShortcut}">
                                    <TextBlock Text="Ctrl+1" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavThreatScanner"
                                     Style="{StaticResource AuraNavButton}"
                                     Command="{Binding NavigateToCommand}"
                                     CommandParameter="ThreatScanner"
                                     AutomationProperties.Name="Threat Scanner"
                                     AutomationProperties.AcceleratorKey="Ctrl+2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="ShieldSearch" Width="18" Height="18" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource AuraErr}" />
                                <TextBlock Grid.Column="1" Text="Threat Scanner" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Style="{StaticResource NavShortcut}">
                                    <TextBlock Text="Ctrl+2" />
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- ─── CLEANUP section (collapsible) ─── -->
                        <Button Style="{StaticResource NavGroupHeader}"
                                Command="{Binding ToggleCleanupCommand}"
                                AutomationProperties.Name="Cleanup section"
                                AutomationProperties.HelpText="Show or hide cleanup tools"
                                ToolTip="Show or hide cleanup tools">
                            <Grid>
                                <controls:TrackedText Text="Cleanup" Tracking="0.1" VerticalAlignment="Center"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource AuraAccentSoft}" />
                                <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                         Foreground="{DynamicResource AuraAccentSoft}"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         RenderTransformOrigin="0.5,0.5">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <RotateTransform Angle="{Binding IsCleanupExpanded, Converter={StaticResource ExpandedChevronAngle}}" />
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                            </Grid>
                        </Button>

                        <StackPanel Visibility="{Binding IsCleanupExpanded, Converter={StaticResource BoolToVis}}">
                            <RadioButton x:Name="NavCleaner"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="Cleaner"
                                         AutomationProperties.Name="System Cleaner"
                                         AutomationProperties.AcceleratorKey="Ctrl+4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Broom" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraAccentSoft}" />
                                    <TextBlock Grid.Column="1" Text="System Cleaner" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Style="{StaticResource NavShortcut}">
                                        <TextBlock Text="Ctrl+4" />
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavBrowser"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="Browser"
                                         AutomationProperties.Name="Privacy Clean"
                                         AutomationProperties.AcceleratorKey="Ctrl+6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Web" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraAccentSoft}" />
                                    <TextBlock Grid.Column="1" Text="Privacy Clean" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Style="{StaticResource NavShortcut}">
                                        <TextBlock Text="Ctrl+6" />
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavUninstaller"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="Uninstaller"
                                         AutomationProperties.Name="Uninstaller"
                                         AutomationProperties.AcceleratorKey="Ctrl+3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="DeleteForever" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraAccentSoft}" />
                                    <TextBlock Grid.Column="1" Text="Uninstaller" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Style="{StaticResource NavShortcut}">
                                        <TextBlock Text="Ctrl+3" />
                                    </Border>
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <!-- ─── ANALYZE section (collapsible) ─── -->
                        <Button Style="{StaticResource NavGroupHeader}"
                                Command="{Binding ToggleAnalyzeCommand}"
                                AutomationProperties.Name="Analyze section"
                                AutomationProperties.HelpText="Show or hide analyze tools"
                                ToolTip="Show or hide analyze tools">
                            <Grid>
                                <controls:TrackedText Text="Analyze" Tracking="0.1" VerticalAlignment="Center"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource AuraInfo}" />
                                <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                         Foreground="{DynamicResource AuraInfo}"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         RenderTransformOrigin="0.5,0.5">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <RotateTransform Angle="{Binding IsAnalyzeExpanded, Converter={StaticResource ExpandedChevronAngle}}" />
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                            </Grid>
                        </Button>

                        <StackPanel Visibility="{Binding IsAnalyzeExpanded, Converter={StaticResource BoolToVis}}">
                            <RadioButton x:Name="NavStorage"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="StorageMap"
                                         AutomationProperties.Name="Storage Map"
                                         AutomationProperties.AcceleratorKey="Ctrl+7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ChartDonut" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraInfo}" />
                                    <TextBlock Grid.Column="1" Text="Storage Map" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Style="{StaticResource NavShortcut}">
                                        <TextBlock Text="Ctrl+7" />
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavDuplicates"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="Duplicates"
                                         AutomationProperties.Name="Duplicate Finder">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ContentDuplicate" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraInfo}" />
                                    <TextBlock Grid.Column="1" Text="Duplicate Finder" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <!-- ─── OPTIMIZE section (collapsible) ─── -->
                        <Button Style="{StaticResource NavGroupHeader}"
                                Command="{Binding ToggleOptimizeCommand}"
                                AutomationProperties.Name="Optimize section"
                                AutomationProperties.HelpText="Show or hide optimize tools"
                                ToolTip="Show or hide optimize tools">
                            <Grid>
                                <controls:TrackedText Text="Optimize" Tracking="0.1" VerticalAlignment="Center"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource AuraOk}" />
                                <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                         Foreground="{DynamicResource AuraOk}"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         RenderTransformOrigin="0.5,0.5">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <RotateTransform Angle="{Binding IsOptimizeExpanded, Converter={StaticResource ExpandedChevronAngle}}" />
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                            </Grid>
                        </Button>

                        <StackPanel Visibility="{Binding IsOptimizeExpanded, Converter={StaticResource BoolToVis}}">
                            <RadioButton x:Name="NavMemory"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="Memory"
                                         AutomationProperties.Name="RAM Booster"
                                         AutomationProperties.AcceleratorKey="Ctrl+5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Memory" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraOk}" />
                                    <TextBlock Grid.Column="1" Text="RAM Booster" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Style="{StaticResource NavShortcut}">
                                        <TextBlock Text="Ctrl+5" />
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavDiskOptimizer"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="DiskOptimizer"
                                         AutomationProperties.Name="Disk Optimizer">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Harddisk" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraOk}" />
                                    <TextBlock Grid.Column="1" Text="Disk Optimizer" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavStartup"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="Startup"
                                         AutomationProperties.Name="Startup Manager"
                                         AutomationProperties.AcceleratorKey="Ctrl+8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="RocketLaunch" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraOk}" />
                                    <TextBlock Grid.Column="1" Text="Startup Manager" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Style="{StaticResource NavShortcut}">
                                        <TextBlock Text="Ctrl+8" />
                                    </Border>
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <!-- ─── UTILITIES section (collapsible) ─── -->
                        <Button Style="{StaticResource NavGroupHeader}"
                                Command="{Binding ToggleUtilitiesCommand}"
                                AutomationProperties.Name="Utilities section"
                                AutomationProperties.HelpText="Show or hide utilities"
                                ToolTip="Show or hide utilities">
                            <Grid>
                                <controls:TrackedText Text="Utilities" Tracking="0.1" VerticalAlignment="Center"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource AuraWarn}" />
                                <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                         Foreground="{DynamicResource AuraWarn}"
                                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                                         RenderTransformOrigin="0.5,0.5">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <RotateTransform Angle="{Binding IsUtilitiesExpanded, Converter={StaticResource ExpandedChevronAngle}}" />
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>
                            </Grid>
                        </Button>

                        <StackPanel Visibility="{Binding IsUtilitiesExpanded, Converter={StaticResource BoolToVis}}">
                            <RadioButton x:Name="NavLargeFiles"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="LargeFiles"
                                         AutomationProperties.Name="Large File Finder">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="FileFind" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraWarn}" />
                                    <TextBlock Grid.Column="1" Text="Large File Finder" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavShredder"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="Shredder"
                                         AutomationProperties.Name="File Shredder"
                                         AutomationProperties.AcceleratorKey="Ctrl+9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ShieldLock" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraWarn}" />
                                    <TextBlock Grid.Column="1" Text="File Shredder" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2" Style="{StaticResource NavShortcut}">
                                        <TextBlock Text="Ctrl+9" />
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavSystemInfo"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="SystemInfo"
                                         AutomationProperties.Name="System Info">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraWarn}" />
                                    <TextBlock Grid.Column="1" Text="System Info" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavQuarantine"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="Quarantine"
                                         AutomationProperties.Name="Quarantine">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ShieldOff" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraWarn}" />
                                    <TextBlock Grid.Column="1" Text="Quarantine" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavSoftwareUpdater"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="SoftwareUpdater"
                                         AutomationProperties.Name="Software Updater">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Update" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraWarn}" />
                                    <TextBlock Grid.Column="1" Text="Software Updater" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavFileRecovery"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="FileRecovery"
                                         AutomationProperties.Name="File Recovery">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="FileRestore" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraWarn}" />
                                    <TextBlock Grid.Column="1" Text="File Recovery" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavEmptyFolders"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="EmptyFolders"
                                         AutomationProperties.Name="Empty Folders">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="FolderRemove" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraWarn}" />
                                    <TextBlock Grid.Column="1" Text="Empty Folders" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavAppInstaller"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="AppInstaller"
                                         AutomationProperties.Name="App Installer">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="PackageDown" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraWarn}" />
                                    <TextBlock Grid.Column="1" Text="App Installer" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavMonitor"
                                         Style="{StaticResource AuraNavButton}"
                                         Command="{Binding NavigateToCommand}"
                                         CommandParameter="Monitor"
                                         AutomationProperties.Name="Install Monitor">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="CameraOutline" Width="18" Height="18" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AuraWarn}" />
                                    <TextBlock Grid.Column="1" Text="Install Monitor" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <!-- ─── Bottom-pinned: History & Settings ─── -->
                        <Rectangle Height="1" Margin="16,12,16,8" Fill="{DynamicResource AuraBorderSubtle}" />

                        <RadioButton x:Name="NavHistory"
                                     Style="{StaticResource AuraNavButton}"
                                     Command="{Binding NavigateToCommand}"
                                     CommandParameter="History"
                                     AutomationProperties.Name="Cleanup History">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="ClipboardTextClock" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Cleanup History" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavSettings"
                                     Style="{StaticResource AuraNavButton}"
                                     Command="{Binding NavigateToCommand}"
                                     CommandParameter="Settings"
                                     AutomationProperties.Name="Settings"
                                     AutomationProperties.AcceleratorKey="Ctrl+0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Settings" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Style="{StaticResource NavShortcut}">
                                    <TextBlock Text="Ctrl+0" />
                                </Border>
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: mode, admin status, version, theme -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource AuraBorderSubtle}" BorderThickness="0,1,0,0"
                        Padding="12,12,12,10">
                    <StackPanel>
                        <Button Style="{StaticResource AuraGhostButton}"
                                Command="{Binding ToggleExperienceModeCommand}"
                                AutomationProperties.Name="{Binding ExperienceModeToggleLabel}"
                                Padding="10,8"
                                HorizontalContentAlignment="Stretch"
                                ToolTip="{Binding ExperienceModeDescription}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Tune"
                                                         Width="16" Height="16"
                                                         Foreground="{DynamicResource AuraAccentSoft}"
                                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding ExperienceModeLabel, StringFormat='{}{0} Mode'}"
                                               Foreground="{DynamicResource AuraTextBright}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ExperienceModeDescription}"
                                               Foreground="{DynamicResource AuraTextMuted}"
                                               FontSize="11" FontWeight="Normal"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.Name="Running as administrator"
                                        ToolTip="AuraClean is running with administrator rights">
                                <materialDesign:PackIcon Kind="ShieldCheck" Width="14" Height="14"
                                                         Foreground="{DynamicResource AuraOk}"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="Administrator" Margin="6,0,0,0"
                                           FontSize="11" FontWeight="Medium"
                                           Foreground="{DynamicResource AuraTextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding AppVersion}"
                                       Style="{StaticResource AuraMono}"
                                       Foreground="{DynamicResource AuraTextMuted}"
                                       FontSize="10"
                                       Margin="8,0,4,0"
                                       VerticalAlignment="Center" />

                            <!-- Theme toggle: Auto (system) → Light → Dark -->
                            <Button Grid.Column="3"
                                    Style="{StaticResource AuraIconButton}"
                                    Command="{Binding CycleThemeCommand}"
                                    ToolTip="{Binding ThemeToggleLabel}"
                                    AutomationProperties.Name="{Binding ThemeToggleLabel}">
                                <materialDesign:PackIcon Width="16" Height="16">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="ThemeLightDark" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ThemeMode}" Value="Light">
                                                    <Setter Property="Kind" Value="WeatherSunny" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ThemeMode}" Value="Dark">
                                                    <Setter Property="Kind" Value="WeatherNight" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- View Content: switched by CurrentViewName -->
            <Grid Grid.Row="0">
                <!-- Dashboard View -->
                <views:DashboardView DataContext="{Binding}"
                                     Visibility="Collapsed"
                                     x:Name="DashboardContent" />

                <!-- Uninstaller View -->
                <views:UninstallerView DataContext="{Binding Uninstaller}"
                                       Visibility="Collapsed"
                                       x:Name="UninstallerContent" />

                <!-- Cleaner View -->
                <views:CleanerView DataContext="{Binding Cleaner}"
                                   Visibility="Collapsed"
                                   x:Name="CleanerContent" />

                <!-- Memory Boost View -->
                <views:MemoryBoostView DataContext="{Binding Memory}"
                                       Visibility="Collapsed"
                                       x:Name="MemoryContent" />

                <!-- Browser Cleaner View -->
                <views:BrowserCleanerView DataContext="{Binding BrowserCleaner}"
                                          Visibility="Collapsed"
                                          x:Name="BrowserContent" />

                <!-- Storage Map View -->
                <views:StorageMapView DataContext="{Binding DiskAnalyzer}"
                                      Visibility="Collapsed"
                                      x:Name="StorageMapContent" />

                <!-- Install Monitor View -->
                <views:InstallMonitorView DataContext="{Binding InstallMonitor}"
                                          Visibility="Collapsed"
                                          x:Name="MonitorContent" />

                <!-- Startup Manager View -->
                <views:StartupManagerView DataContext="{Binding StartupManager}"
                                          Visibility="Collapsed"
                                          x:Name="StartupContent" />

                <!-- Duplicate Finder View -->
                <views:DuplicateFinderView DataContext="{Binding DuplicateFinder}"
                                           Visibility="Collapsed"
                                           x:Name="DuplicatesContent" />

                <!-- File Shredder View -->
                <views:FileShredderView DataContext="{Binding FileShredder}"
                                        Visibility="Collapsed"
                                        x:Name="ShredderContent" />

                <!-- Large File Finder View -->
                <views:LargeFileFinderView DataContext="{Binding LargeFileFinder}"
                                           Visibility="Collapsed"
                                           x:Name="LargeFilesContent" />

                <!-- System Info View -->
                <views:SystemInfoView DataContext="{Binding SystemInfo}"
                                      Visibility="Collapsed"
                                      x:Name="SystemInfoContent" />

                <!-- Settings View -->
                <views:SettingsView DataContext="{Binding Settings}"
                                    Visibility="Collapsed"
                                    x:Name="SettingsContent" />

                <!-- Cleanup History View -->
                <views:CleanupHistoryView DataContext="{Binding CleanupHistory}"
                                          Visibility="Collapsed"
                                          x:Name="HistoryContent" />

                <!-- Quarantine View -->
                <views:QuarantineView DataContext="{Binding Quarantine}"
                                      Visibility="Collapsed"
                                      x:Name="QuarantineContent" />

                <!-- Threat Scanner View -->
                <views:ThreatScannerView DataContext="{Binding ThreatScanner}"
                                         Visibility="Collapsed"
                                         x:Name="ThreatScannerContent" />

                <!-- Software Updater View -->
                <views:SoftwareUpdaterView DataContext="{Binding SoftwareUpdater}"
                                           Visibility="Collapsed"
                                           x:Name="SoftwareUpdaterContent" />

                <!-- Disk Optimizer View -->
                <views:DiskOptimizerView DataContext="{Binding DiskOptimizer}"
                                         Visibility="Collapsed"
                                         x:Name="DiskOptimizerContent" />

                <!-- File Recovery View -->
                <views:FileRecoveryView DataContext="{Binding FileRecovery}"
                                        Visibility="Collapsed"
                                        x:Name="FileRecoveryContent" />

                <!-- Empty Folder Finder View -->
                <views:EmptyFolderFinderView DataContext="{Binding EmptyFolderFinder}"
                                              Visibility="Collapsed"
                                              x:Name="EmptyFoldersContent" />

                <!-- App Bundle Installer View -->
                <views:AppInstallerView DataContext="{Binding AppInstaller}"
                                        Visibility="Collapsed"
                                        x:Name="AppInstallerContent" />
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource AuraShellBackground}"
                    BorderBrush="{DynamicResource AuraCardBorder}" BorderThickness="0,1,0,0"
                    Padding="20,7">
                <TextBlock Text="{Binding StatusBarText}"
                           AutomationProperties.LiveSetting="Polite"
                           Foreground="{DynamicResource AuraTextSecondary}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusBarText}"
                           FontSize="11" />
            </Border>
        </Grid>

        <!-- ═══ ONBOARDING OVERLAY (full-window) ═══ -->
        <views:OnboardingView DataContext="{Binding Onboarding}"
                               Visibility="Collapsed"
                               x:Name="OnboardingOverlay"
                               Grid.ColumnSpan="2"
                               Panel.ZIndex="100" />
    </Grid>
</Window>
